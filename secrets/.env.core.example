# Copy to secrets/.env.core and fill in. secrets/ is gitignored.
# Supabase dashboard -> Project Settings -> API

ENV=local
APP_NAME=template
LOG_LEVEL=INFO

DB_URL=https://your-project-ref.supabase.co
DB_PUBLISHABLE_KEY=sb_publishable_xxx
# SERVER ONLY. Bypasses RLS entirely. Never ship to a client.
DB_SECRET_KEY=sb_secret_xxx

# Optional: overrides the derived hostname (raw *.run.app URL, PR preview).
# API_HOST=https://core-dev-xxxx.us-east4.run.app