# Secrets
# NOTE: ignore the CONTENTS of secrets/, not the directory. A trailing slash
# ("secrets/") excludes the directory itself, and git never descends into an
# excluded directory -- so a later "!secrets/*.example" can never re-include
# anything inside it.
secrets/*
.env
.env.*
*.pem
*.key
*.p12
credentials.json
service-account*.json

# Re-include example templates. These MUST come after the patterns above:
# the last matching pattern wins, and ".env.*" above would otherwise swallow
# secrets/.env.core.example.
!secrets/*.example
!.env.example
!.env.*.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Local
*.log
.python-version